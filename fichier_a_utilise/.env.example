# ══════════════════════════════════════════════════════════════
# .env.example — Backend Laravel — MOS OFPPT
# Copier en .env et remplir les valeurs réelles
# ⚠️  Ne JAMAIS committer le fichier .env dans Git
# ══════════════════════════════════════════════════════════════

APP_NAME="MOS OFPPT"
APP_ENV=local
APP_KEY=                          # Générer : php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_TIMEZONE=Africa/Casablanca

# ── Base de données MySQL ──────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mos_ofppt
DB_USERNAME=mos_user
DB_PASSWORD=mos_secret
DB_ROOT_PASSWORD=root_secret

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ── Cache & Session ────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ── Sanctum (CORS SPA) ─────────────────────────────────────────
# URL(s) du frontend séparées par des virgules
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# ── CORS ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Mail ───────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025                    # MailHog en dev (docker-compose --profile tools)
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@mos-ofppt.ma"
MAIL_FROM_NAME="MOS OFPPT"

# ── Storage ────────────────────────────────────────────────────
FILESYSTEM_DISK=local
